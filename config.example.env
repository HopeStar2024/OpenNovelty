# ============================================================
# PubMed E-utilities (Phase 2 search backend)
# ============================================================
# NCBI API key. REQUIRED for the 10 req/s rate limit.
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Recommended: identify your application to NCBI (avoids throttling warnings)
NCBI_TOOL_NAME=opennovelty-pubmed

# Recommended: contact email NCBI can reach you at if your key misbehaves
NCBI_EMAIL=

# Max results per search query (ESearch retmax). Default: 50
PUBMED_MAX_RESULTS=50

# ============================================================
# LLM (Phase 1 extraction / Phase 3 analysis / Phase 4 report)
# ============================================================
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_API_ENDPOINT=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o

# ============================================================
# Optional pipeline tuning (defaults shown)
# ============================================================
# MAX_SEARCH_RESULTS=10
# PHASE2_QUERY_CONCURRENCY=1
# PHASE2_ALIAS_MODE=heuristic   # llm | heuristic (citation_index aliases)
